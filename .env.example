# ─────────────────────────────────────────────────────────────
# DreamJobResume — environment variables (all optional)
# Copy to .env.local. NEVER commit real keys.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for SEO canonical URLs). Optional on Vercel.
NEXT_PUBLIC_SITE_URL=

# AI (optional). Without a key the site uses its free built-in engine.
# With a key, resume reading and tailoring use OpenAI (small per-use cost).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
